<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="AsterionTheme" parent="android:style/Theme.Material.Light.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">#6546C7</item>
    <item name="android:colorControlActivated">#8D7AF5</item>
    <item name="android:colorButtonNormal">#EEF0F5</item>
    <item name="android:textColorPrimary">#181D26</item>
    <item name="android:textColorSecondary">#566174</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:statusBarColor">#F7F8FA</item>
    <item name="android:navigationBarColor">#F7F8FA</item>
    <item name="android:alertDialogTheme">@style/AsterionDialog</item>
    <item name="android:dialogTheme">@style/AsterionDialog</item>
  </style>
  <style name="AsterionDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
    <item name="android:windowBackground">@drawable/asterion_dialog_background</item>
    <item name="android:windowMinWidthMinor">92%</item>
    <item name="android:windowMinWidthMajor">80%</item>
    <item name="android:colorAccent">#6546C7</item>
    <item name="android:colorControlActivated">#8D7AF5</item>
    <item name="android:textColorPrimary">#181D26</item>
    <item name="android:textColorSecondary">#566174</item>
    <item name="android:fontFamily">sans</item>
  </style>
</resources>
