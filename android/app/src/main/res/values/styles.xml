<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="AsterionTheme" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">#9783FF</item>
    <item name="android:colorControlActivated">#8D7AF5</item>
    <item name="android:colorButtonNormal">#282F4C</item>
    <item name="android:textColorPrimary">#F3F4FF</item>
    <item name="android:textColorSecondary">#ADB9D4</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:statusBarColor">#101627</item>
    <item name="android:navigationBarColor">#101627</item>
    <item name="android:alertDialogTheme">@style/AsterionDialog</item>
    <item name="android:dialogTheme">@style/AsterionDialog</item>
  </style>
  <style name="AsterionDialog" parent="android:style/Theme.Material.Dialog.Alert">
    <item name="android:windowBackground">@drawable/asterion_dialog_background</item>
    <item name="android:windowMinWidthMinor">92%</item>
    <item name="android:windowMinWidthMajor">80%</item>
    <item name="android:colorAccent">#B49DFF</item>
    <item name="android:colorControlActivated">#8D7AF5</item>
    <item name="android:textColorPrimary">#F3F4FF</item>
    <item name="android:textColorSecondary">#ADB9D4</item>
    <item name="android:fontFamily">sans</item>
  </style>
</resources>
